# ── Isolyth server – environment variables ────────────────────────────────────
# Copy this file to .env and fill in real values before running the server.
# Load it with: export $(cat .env | xargs)
# Or use python-dotenv / direnv.

# ── PostgreSQL (db_query_tool) ─────────────────────────────────────────────────
# asyncpg connection DSN.
# For local Docker Postgres (see README for docker run command):
DATABASE_URL=postgresql://isolyth_user:isolyth_pass@localhost:5432/isolyth_db

# Per-query timeout in seconds (default: 10).
DB_QUERY_TIMEOUT_S=10

# Maximum rows returned per query (default: 500).
DB_MAX_ROWS=500

# ── Web fetch (web_fetch_tool) ─────────────────────────────────────────────────
# Connect+read timeout in seconds (default: 5).
WEB_FETCH_TIMEOUT_S=5

# Maximum response body size in bytes (default: 2 MB = 2097152).
WEB_FETCH_MAX_BYTES=2097152

# ── File ops (file_ops_tool) ───────────────────────────────────────────────────
# Absolute path to the sandboxed directory.  No files outside this root are
# accessible regardless of the path supplied by the caller.
FILE_OPS_SANDBOX_ROOT=/tmp/isolyth_workspace

# Maximum file size readable in one call in bytes (default: 1 MB = 1048576).
FILE_OPS_MAX_READ_BYTES=1048576

# ── Code execution (code_exec_tool) ───────────────────────────────────────────
# Absolute path to the compiled eval.wasm.
# Default: auto-discovered from server/wasm_modules/eval.wasm
# CODE_EXEC_WASM_PATH=/path/to/eval.wasm

# Fuel budget for the expression evaluator (default: 10_000_000 instructions).
CODE_EXEC_MAX_FUEL=10000000

# Wall-clock timeout for expression evaluation in seconds (default: 3).
CODE_EXEC_TIMEOUT_S=3
